---
import "../styles/global.css";
import { siteConfig, type JsonLd } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  schema?: JsonLd | JsonLd[];
  openGraphType?: "website" | "article";
}

const {
  title,
  description,
  canonical,
  image,
  noindex,
  schema,
  openGraphType = "website",
} = Astro.props;

const pageTitle = title
  ? siteConfig.seo.titleTemplate
      .replace("{page}", title)
      .replace("{site}", siteConfig.name)
  : siteConfig.name;

const pageDescription = description ?? siteConfig.description;
const faviconPath = siteConfig.favicon
  ? `${import.meta.env.BASE_URL}${siteConfig.favicon.replace(/^\//, "")}`
  : undefined;
const configuredSiteUrl = siteConfig.url.trim();
const canonicalUrl = canonical
  ? /^https?:\/\//i.test(canonical)
    ? canonical
    : configuredSiteUrl
      ? new URL(canonical, configuredSiteUrl).href
      : undefined
  : configuredSiteUrl
    ? new URL(Astro.url.pathname, configuredSiteUrl).href
    : undefined;

const imagePath = image ?? siteConfig.seo.defaultImage;
const socialImageUrl = imagePath
  ? /^https?:\/\//i.test(imagePath)
    ? imagePath
    : configuredSiteUrl
      ? new URL(imagePath, configuredSiteUrl).href
      : undefined
  : undefined;

const shouldNoindex =
  siteConfig.seo.noindex || !configuredSiteUrl || Boolean(noindex);
const siteSchemas = Array.isArray(siteConfig.schema)
  ? siteConfig.schema
  : siteConfig.schema
    ? [siteConfig.schema]
    : [];
const pageSchemas = Array.isArray(schema)
  ? schema
  : schema
    ? [schema]
    : [];
const schemaBlocks = [...siteSchemas, ...pageSchemas];
const serializedSchemas = schemaBlocks.map((item) =>
  JSON.stringify(item).replace(/</g, "\\u003c"),
);
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>

    {
      pageDescription && (
        <meta name="description" content={pageDescription} />
      )
    }
    {
      shouldNoindex && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    {
      faviconPath && (
        <link rel="icon" type="image/png" href={faviconPath} />
      )
    }
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      socialImageUrl && (
        <meta property="og:image" content={socialImageUrl} />
      )
    }
    <meta
      name="twitter:card"
      content={socialImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    {pageDescription && <meta name="twitter:description" content={pageDescription} />}
    {
      socialImageUrl && (
        <meta name="twitter:image" content={socialImageUrl} />
      )
    }

    {
      serializedSchemas.map((serializedSchema) => (
        <script
          type="application/ld+json"
          set:html={serializedSchema}
        ></script>
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <slot />
  </body>
</html>
