---
import FadeInText from "@astroanimate/core/FadeInText";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";

const homeHref = import.meta.env.BASE_URL;
---

<BaseLayout title="Página não encontrada" noindex>
  <main
    id="main-content"
    class="mx-auto flex min-h-screen max-w-site flex-col justify-center px-6 py-16"
  >
    <FadeInText
      as="p"
      class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-muted"
      duration={0.35}
      blur="3px"
      yOffset={8}
    >
      Erro 404
    </FadeInText>
    <h1 class="font-heading text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      Página não encontrada
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
      O endereço pode ter mudado ou não existir.
    </p>
    <a
      class="mt-8 flex w-fit items-center gap-2 rounded-control bg-brand px-5 py-3 font-semibold text-on-brand"
      href={homeHref}
    >
      <Icon name="arrow-left" aria-hidden="true" class="size-4" />
      <span>Voltar ao início</span>
    </a>
  </main>
</BaseLayout>
